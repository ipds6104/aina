/target
/data/*.db
/data/*.db-shm
/data/*.db-wal

# Legacy single workspace
/workspace/*
!/workspace/.gitkeep

# Multi-workspace rules: ignore heavy data, outputs, and python cache
/workspaces/**/data/*
!/workspaces/**/data/.gitkeep
/workspaces/**/output/*
!/workspaces/**/output/.gitkeep
/workspaces/**/__pycache__/
*.pyc

/workspaces/**/skills
/workspaces/**/shared_data
.env
*.log

# Global Shared Data Lake (heavy analytical datasets, DuckDB, Parquet, SQLite)
/shared_data/*
!/shared_data/.gitkeep
!/shared_data/README.md

# Heavy analytical & database file extensions
*.duckdb
*.duckdb.wal
*.parquet
*.arrow
*.feather
*.h5
*.hdf5

# Google OAuth secrets & tokens
*client_secrets*.json
*google_token*.json
config/client_secrets.json
data/google_token.json
/data/token_pool.json
/data/oauth_sessions/
/data/saved_tokens/

# User custom character sheets & avatars (prevent git overwrite on updates)
/assets/character_sheet.png
/assets/avatar.png
/assets/character_sheet.jpg
/assets/avatar.jpg
