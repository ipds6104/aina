# ==============================================================================
# Aina Environment Configuration (Paste directly into Coolify Environment Variables)
# ==============================================================================

# Server configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8090
PORT=8090

# Whatsmeow Gateway (Hosted by you)
WHATSMEOW_BASE_URL=http://your-whatsmeow-host:3000
WHATSMEOW_API_KEY=your_secret_api_key_here
WHATSMEOW_BOT_JID=628123456789@s.whatsapp.net
WHATSMEOW_BOT_NAME=Aina

# Whatsmeow custom endpoints (if different from default)
# WHATSMEOW_SEND_ENDPOINT=/send/message
# WHATSMEOW_PRESENCE_ENDPOINT=/send/presence

# Antigravity Agent Configuration
AGENT_MODEL=gemini-3.8-flash-medium
AGENT_TIMEOUT_SECONDS=300
AGENT_WORKSPACE=/app/workspaces/default
AINA_WORKSPACES_DIR=/app/workspaces
DATABASE_PATH=/app/data/aina.db

# ==============================================================================
# Antigravity Authentication Options (PILIH SALAH SATU UNTUK DEPLOY PERTAMA)
# ==============================================================================
# OPSI A (Paling Praktis untuk Coolify):
# Salin isi dari berkas `~/.gemini/antigravity-cli/antigravity-oauth-token` di laptop/mesin lokalmu,
# lalu tempel string token tersebut ke env variable di bawah ini:
AINA_OAUTH_TOKEN=

# OPSI B (Google Gemini Developer API Key / ADC):
# GEMINI_API_KEY=your_gemini_api_key_here

# OPSI C (Custom Persona override via ENV):
# AINA_PERSONA_TEXT=
